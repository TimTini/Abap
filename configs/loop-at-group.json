{
  "object": "LOOP_AT_ITAB",
  "match": { "startPhrase": "LOOP AT GROUP" },
  "extras": { "type": "loopAtItab" },
  "block": { "endKeyword": "ENDLOOP" },
  "keywordLabels": {
    "LOOP": "stmt",
    "AT": "at",
    "GROUP": "group",
    "INTO": "into",
    "ASSIGNING": "assigning",
    "REFERENCE": "reference",
    "WHERE": "where",
    "GROUP BY": "group-by"
  },
  "keywordPhrases": {
    "LOOP AT GROUP": "loop-at-group",
    "REFERENCE INTO": "reference-into",
    "GROUP BY": "group-by"
  },
  "captureRules": [
    { "after": "LOOP AT GROUP", "name": "group", "label": "group" },
    { "after": "INTO", "name": "into", "label": "into" },
    { "after": "ASSIGNING", "name": "assigning", "label": "assigning" },
    { "after": "REFERENCE INTO", "name": "refInto", "label": "reference-into" },
    { "after": "WHERE", "name": "where", "label": "where", "capture": "rest", "stopTokens": ["GROUP"] },
    { "after": "GROUP BY", "name": "groupBy", "label": "group-by", "capture": "rest", "stopTokens": ["INTO", "ASSIGNING", "REFERENCE"] }
  ]
